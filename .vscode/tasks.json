{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cmake",
			"label": "CMake: build",
			"command": "build",
			"targets": [
				"all"
			],
			"group": "build",
			"problemMatcher": [],
			"detail": "CMake template build task"
		},
		{
			"type": "shell",
			"label": "flash",
			"command": "st-flash",
			"args": [
				"--reset",
				"write",
				"${workspaceFolder}/build/Debug/${workspaceFolderBasename}.bin",
				"0x8000000"
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"dependsOn": "CMake: build",
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "Builds project and flashes firmware."
		},
		{
			"type": "shell",
			"label": "erase",
			"command": "st-flash",
			"args": [
				"--connect-under-reset",
				"erase"
			],
			"detail": "mass erase of chip"
		}
	]
}