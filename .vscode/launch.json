{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
			"name": "openocd",
			"type": "cortex-debug",
			"request": "launch",
			"cwd": "${workspaceRoot}",
			"servertype": "openocd",
			"executable": "${workspaceFolder}/build/Debug/${workspaceFolderBasename}.elf",
			"svdFile": "STM32L475.svd",
			"configFiles": [
				"interface/stlink-v2.cfg",
				"target/stm32l4x.cfg"
			],			
            "runToEntryPoint": "main",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 1
            },
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                    "label": "RTT channel 0",
                    "port": 0,
                    "type": "console"
                    }
                ]
                },
		},
        {
			"name": "openocd attach",
			"type": "cortex-debug",
			"request": "attach",
			"cwd": "${workspaceRoot}",
			"servertype": "openocd",
			"executable": "${workspaceFolder}/build/Debug/${workspaceFolderBasename}.elf",
			"svdFile": "STM32L475.svd",
			"configFiles": [
				"interface/stlink-v2.cfg",
				"target/stm32l4x.cfg"
			],			
            "runToEntryPoint": "main",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 1
            },
		},
        {
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/build/Debug/${workspaceFolderBasename}.elf",
            "name": "Debug with OpenOCD",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "svdFile": "STM32L475.svd",
            "configFiles": [
				"interface/stlink-v2.cfg",
				"target/stm32l4x.cfg"
            ],
            "searchDir": [],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 1
            },
        },
        {
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/${workspaceFolderBasename}.elf",
            "name": "Debug with PyOCD",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "servertype": "pyocd",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
        },
        {
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/${workspaceFolderBasename}.elf",
            "name": "Debug with ST-Util",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "servertype": "stutil",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
        }
    ]
}